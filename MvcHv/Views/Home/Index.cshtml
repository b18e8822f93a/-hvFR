@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-4">
    <h1 class="h3 mb-3">API Test Viewer</h1>

    <button id="load-test-payload" class="btn btn-primary" type="button">
        Load API Payload
    </button>

    <div class="mt-3">
        <label for="x-input" class="form-label">Value for x</label>
        <input id="x-input" class="form-control" type="text" value="cat" />
        <button id="send-test-payload" class="btn btn-success mt-2" type="button">
            Send To /api/test
        </button>
    </div>

    <div class="mt-3">
        <label for="search-query" class="form-label">Search query</label>
        <input id="search-query" class="form-control" type="text" value="hospital" />

        <label for="search-topk" class="form-label mt-2">Top K</label>
        <input id="search-topk" class="form-control" type="number" min="1" value="5" />

        <button id="send-search-payload" class="btn btn-warning mt-2" type="button">
            Send To /api/search
        </button>
    </div>

    <div class="mt-3">
        <label for="api-output" class="form-label">Response</label>
        <pre id="api-output" class="border rounded p-3 bg-light mb-0">Click the button to load data.</pre>
    </div>
</div>

@section Scripts {
    <script>
        async function displayResponse(request, pendingMessage) {
            output.textContent = pendingMessage;

            try {
                const response = await request;
                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || data.title || `Request failed (${response.status}).`);
                }

                output.textContent = JSON.stringify(data, null, 2);
            } catch (error) {
                output.textContent = `Request failed: ${error.message}`;
            }
        }

        const loadButton = document.getElementById('load-test-payload');
        const sendButton = document.getElementById('send-test-payload');
        const sendSearchButton = document.getElementById('send-search-payload');
        const xInput = document.getElementById('x-input');
        const searchQueryInput = document.getElementById('search-query');
        const searchTopKInput = document.getElementById('search-topk');
        const output = document.getElementById('api-output');

        loadButton.addEventListener('click', async () => {
            await displayResponse(fetch('/Home/TestPayload'), 'Loading...');
        });

        sendButton.addEventListener('click', async () => {
            await displayResponse(fetch('/Home/TestPayloadWithInput', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ x: xInput.value })
            }), 'Sending...');
        });

        sendSearchButton.addEventListener('click', async () => {
            await displayResponse(fetch('/Home/SearchPayload', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    query: searchQueryInput.value,
                    topK: Number(searchTopKInput.value || 5)
                })
            }), 'Searching...');
        });
    </script>
}
