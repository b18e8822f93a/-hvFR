@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-4">
    <h1 class="h3 mb-3">API Test Viewer</h1>

    <button id="load-test-payload" class="btn btn-primary" type="button">
        Load API Payload
    </button>

    <div class="mt-3">
        <label for="x-input" class="form-label">Value for x</label>
        <input id="x-input" class="form-control" type="text" value="cat" />
        <button id="send-test-payload" class="btn btn-success mt-2" type="button">
            Send To /api/test
        </button>
    </div>

    <div class="mt-3">
        <label for="api-output" class="form-label">Response</label>
        <pre id="api-output" class="border rounded p-3 bg-light mb-0">Click the button to load data.</pre>
    </div>
</div>

@section Scripts {
    <script>
        const loadButton = document.getElementById('load-test-payload');
        const sendButton = document.getElementById('send-test-payload');
        const xInput = document.getElementById('x-input');
        const output = document.getElementById('api-output');

        loadButton.addEventListener('click', async () => {
            output.textContent = 'Loading...';

            const response = await fetch('/Home/TestPayload');
            const data = await response.json();

            output.textContent = JSON.stringify(data, null, 2);
        });

        sendButton.addEventListener('click', async () => {
            output.textContent = 'Sending...';

            const response = await fetch('/Home/TestPayloadWithInput', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ x: xInput.value })
            });

            const data = await response.json();
            output.textContent = JSON.stringify(data, null, 2);
        });
    </script>
}
